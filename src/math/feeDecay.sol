pragma solidity =0.8.33;

/// @dev 2**128: the Q128 unit of the decay chain.
uint256 constant Q128 = 0x100000000000000000000000000000000;

/// @dev Elapsed seconds from which the decay is exactly zero. The table below has one constant per bit of the
/// exponent up to bit 16; the chain itself reaches zero at 76,800 s = 600 * 128 (2**-128), and every exponent at
/// or above 2**17 would otherwise alias to its low 17 bits.
uint256 constant DECAY_ZERO_FROM = 0x20000;

/// @notice `2**(-elapsed / 600)` in Q128: a 600 second half-life, so six halvings over 3,600 seconds.
/// @dev Same construction as `tickToSqrtRatio`: one `round(2**128 * base**(2**i))` constant per exponent bit,
/// multiplied in and floored to Q128 for every set bit, generated by `test/vectors/gen-fee-decay-table.py` from the
/// tick-math generator (starknet-contracts `scripts/codegen/gen-tick-math.ts`). Products fit in 256 bits because the
/// running value is at most 2**128 and every constant is below it. The result is non-increasing in `elapsed` over
/// the whole domain (checked exhaustively by the generator) and within 4 units of 2**-128 of the real value.
function decayQ128(uint256 elapsed) pure returns (uint256 result) {
    if (elapsed >= DECAY_ZERO_FROM) return 0;
    assembly ("memory-safe") {
        // bit 0: a single conditional subtract from 2**128
        result := sub(Q128, mul(and(elapsed, 0x1), 0x4baa9be03697a9bc384a821d46c25f))

        // bits 1..7: every window up to 255 s
        if and(elapsed, 0xfe) {
            if and(elapsed, 0x2) { result := shr(128, mul(result, 0xff68c125a89b955b2cec5e897ba641e0)) }
            if and(elapsed, 0x4) { result := shr(128, mul(result, 0xfed1dba68638bfb9c0cc9d0ff56a3393)) }
            if and(elapsed, 0x8) { result := shr(128, mul(result, 0xfda51be6d4b61b1517e2bfd323d3b6c2)) }
            if and(elapsed, 0x10) { result := shr(128, mul(result, 0xfb4fc3a33b08a547ec1434c8cf4ed7fc)) }
            if and(elapsed, 0x20) { result := shr(128, mul(result, 0xf6b5827c6a03777471be5bb1aa9f8ddb)) }
            if and(elapsed, 0x40) { result := shr(128, mul(result, 0xedc15778e22f2a9d19d78ab31558f4c2)) }
            if and(elapsed, 0x80) { result := shr(128, mul(result, 0xdccf8dfad4f3c2d605c01895804ca0a4)) }
        }

        // bits 8..11: up to 4,095 s, which covers the 3,600 s canonical window
        if and(elapsed, 0xf00) {
            if and(elapsed, 0x100) { result := shr(128, mul(result, 0xbe75644e08659d6e11dc660f7cac0a64)) }
            if and(elapsed, 0x200) { result := shr(128, mul(result, 0x8db276b8ab1790e9ca4fea27d409af09)) }
            if and(elapsed, 0x400) { result := shr(128, mul(result, 0x4e6e1330bc54a5572bc9b369ae03cf4a)) }
            if and(elapsed, 0x800) { result := shr(128, mul(result, 0x180743063215b2baf06deaafe56f4d0f)) }
        }

        // bits 12..16: the remaining nonzero constants
        if and(elapsed, 0x1f000) {
            if and(elapsed, 0x1000) { result := shr(128, mul(result, 0x02415cc5e5470d1091ac784874015d70)) }
            if and(elapsed, 0x2000) { result := shr(128, mul(result, 0x0005162355b2600ea2c6e0c244fa2dc5)) }
            if and(elapsed, 0x4000) { result := shr(128, mul(result, 0x00000019df4b7092f48b13d2e916f37d)) }
            if and(elapsed, 0x8000) { result := shr(128, mul(result, 0x000000000000029d5f80810ef0d05f8e)) }
            if and(elapsed, 0x10000) { result := shr(128, mul(result, 0x6d63c)) }
        }
    }
}

/// @notice Creator fee `elapsed` seconds into a window: the 600 second half-life exponential from `initialFee`
/// towards zero, rescaled so that it leaves `initialFee` at zero and reaches `finalFee` exactly at `duration`, then
/// stays there.
/// @dev Requires `finalFee <= initialFee < 2**64` and `duration > 0`, enforced at launch creation. With
/// `E = decayQ128(duration)` the interior value is
/// `finalFee + floor((initialFee - finalFee) * (decayQ128(elapsed) - E) / (2**128 - E))`, which lies in
/// `[finalFee, initialFee]` and does not increase with `elapsed` because `decayQ128` does not. The product is below
/// 2**192 and the quotient at most `initialFee - finalFee`.
function decayedFee(uint64 initialFee, uint64 finalFee, uint32 duration, uint256 elapsed) pure returns (uint64) {
    if (elapsed == 0) return initialFee;
    if (elapsed >= duration) return finalFee;
    uint256 endpoint = decayQ128(duration);
    unchecked {
        return finalFee + uint64(uint256(initialFee - finalFee) * (decayQ128(elapsed) - endpoint) / (Q128 - endpoint));
    }
}
